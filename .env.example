# Copy to .env and fill in. Never commit the real .env.

# Address peers can reach: the public IP of the host (advertised in XOR-RELAYED-ADDRESS).
EXTERNAL_IP=203.0.113.10

# Must be the same secret the backend signs credentials with (>= 16 chars).
# Generate a new one with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-secret

# --- Replacing coturn (use-auth-secret) ---------------------------------------
# Same realm as coturn's `realm=`:
REALM=telex
# coturn computes the password with HMAC-SHA1:
AUTH_HMAC_ALGO=sha1
# Relay ports (one per allocation => 41 concurrent allocations for this range!):
RELAY_MIN_PORT=49160
RELAY_MAX_PORT=49200
# TURN listening port (published automatically by compose.yaml):
TURN_PORT=3478
# Credentials may be used to keep an existing allocation alive for this long after they expire:
CREDENTIAL_GRACE_SECS=3600
# Optional coturn-style peer rules (built-in rules already block loopback, private, link-local, multicast):
# ALLOWED_PEER_IPS=10.20.0.0/16
# DENIED_PEER_IPS=203.0.113.0-203.0.113.255
